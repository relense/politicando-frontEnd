# Base URL of the Politicando API, including the version
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v2
# Public URL of this site, used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# reCAPTCHA v2 site key (public). Without it, the comment form is replaced by a notice.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Leave empty in production. "off" hides the captcha (develop/testing; the API needs Google's test
# secret so it accepts any token). "mock" shows a fake checkbox (e2e tests).
NEXT_PUBLIC_CAPTCHA_MODE=off
# Plausible domain. Leave empty to disable analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Address for corrections and contact, shown in the footer and on the terms page
NEXT_PUBLIC_CONTACT_EMAIL=
# Address for data requests on the privacy page. Leave empty to use the contact address.
NEXT_PUBLIC_PRIVACY_EMAIL=
# Person or organisation responsible for the site, named on the privacy and terms pages.
# Leave empty to show "Politicando" instead.
NEXT_PUBLIC_SITE_OWNER=

# Server only, never NEXT_PUBLIC_: the same secret as the API's FRONTEND_API_KEY (generate once: openssl rand -hex 32).
# With it, the site's server tells the API which reader a page is for, so each reader gets their own rate limit.
FRONTEND_API_KEY=
