# Base URL of the Politicando API, including the version
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v2
# Public URL of this site, used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# reCAPTCHA v2 site key (public). Without it, the comment form is replaced by a notice.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Set to "mock" for local development and e2e tests only. Real protection is checked by the API.
NEXT_PUBLIC_CAPTCHA_MODE=mock
# Plausible domain. Leave empty to disable analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
